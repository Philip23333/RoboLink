    "@vitejs/plugin-vue": "6.0.10",
    "ts-proto": "2.18.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13"
  }
}
